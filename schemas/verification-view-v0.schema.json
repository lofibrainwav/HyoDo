{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hyodo.app/schemas/verification-view-v0.schema.json",
  "title": "HyoDo Verification View v0",
  "description": "Read-only presentation projection of one hyodo.evidence-graph/v1 payload. Carries no score, confidence, or aggregate, and grants no authority.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "reason", "root", "authority", "presentation", "reconciliation", "time_axis", "lanes", "event_order", "events", "edges_causal", "edges_evidence", "decisions_by_run", "missing", "coverage", "topology"],
  "properties": {
    "acceptance_join": {"type": "object", "additionalProperties": false, "required": ["status", "state", "criteria"], "properties": {"status": {"enum": ["COMPLETE", "NOT_COMPLETE", "HOLD", "CONFLICTING"]}, "state": {"enum": ["PASS", "FAIL", "UNOBSERVED", "CONFLICTING"]}, "criteria": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "text", "state", "comparisons"], "properties": {"id": {"type": "string"}, "text": {"type": "string"}, "state": {"enum": ["PASS", "FAIL", "UNOBSERVED", "CONFLICTING"]}, "comparisons": {"type": "array", "items": {"enum": ["PASS", "FAIL", "UNOBSERVED", "CONFLICTING"]}}}}}, "invariants": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "text", "state", "comparisons"], "properties": {"id": {"type": "string"}, "text": {"type": "string"}, "state": {"enum": ["PASS", "FAIL", "UNOBSERVED", "CONFLICTING"]}, "comparisons": {"type": "array", "items": {"enum": ["PASS", "FAIL", "UNOBSERVED", "CONFLICTING"]}}}}}, "guards": {"type": "object", "additionalProperties": false, "properties": {"verification_observed": {"enum": ["PASS", "FAIL", "UNOBSERVED", "CONFLICTING"]}, "identity_correlation": {"enum": ["PASS", "FAIL", "UNOBSERVED", "CONFLICTING"]}, "visible_readback": {"enum": ["PASS", "FAIL", "UNOBSERVED", "CONFLICTING"]}}}, "contract_id": {"type": ["string", "null"]}, "revision": {"type": ["integer", "null"]}, "origin": {"type": ["string", "null"]}, "criteria_count": {"type": "integer", "minimum": 0}, "contract_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "reason": {"type": "string"}, "boundary": {"type": "string"}}},
    "schema_version": {"const": "hyodo.verification-view/v0"},
    "status": {"type": ["string", "null"]},
    "reason": {"type": ["string", "null"]},
    "root": {"type": ["string", "null"]},
    "authority": {"const": "UNOBSERVED"},
    "presentation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allow_withheld", "reason"],
      "properties": {
        "allow_withheld": {"type": "boolean"},
        "reason": {"type": ["string", "null"]}
      }
    },
    "reconciliation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["terminal_outcomes", "recording", "lens_mapping", "intent_provenance"],
      "properties": {
        "terminal_outcomes": {"type": "object", "additionalProperties": false, "required": ["counts", "terminal_outcome_unobserved", "duplicate_terminal", "undispositioned_calls"], "properties": {"counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}}, "terminal_outcome_unobserved": {"type": "integer", "minimum": 0}, "duplicate_terminal": {"type": "integer", "minimum": 0}, "undispositioned_calls": {"type": "integer", "minimum": 0}}},
        "recording": {"type": "object", "additionalProperties": false, "required": ["counts", "unexplained_required_gaps"], "properties": {"counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}}, "unexplained_required_gaps": {"type": "integer", "minimum": 0}}},
        "lens_mapping": {"type": "object", "additionalProperties": false, "required": ["counts", "mapping_gaps"], "properties": {"counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}}, "mapping_gaps": {"type": "integer", "minimum": 0}}},
        "intent_provenance": {"type": "object", "additionalProperties": false, "required": ["counts", "by_run", "undispositioned_runs", "unauthorized_executions"], "properties": {"counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}}, "by_run": {"type": "object", "additionalProperties": {"enum": ["RECORDED_INTENT", "ADMISSION_UNOBSERVED", "EXPLICIT_NO_INTENT"]}}, "undispositioned_runs": {"type": "integer", "minimum": 0}, "unauthorized_executions": {"const": "NOT_PROVEN"}}}
      }
    },
    "time_axis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["direction", "continuity_lens", "order_fields"],
      "properties": {
        "direction": {"const": "left_to_right"},
        "continuity_lens": {"const": "eternity"},
        "order_fields": {"type": "array", "items": {"type": "string"}}
      }
    },
    "lanes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["lane_id", "label", "actor", "role", "depth", "parent_lane", "events", "hyo_hierarchy"],
        "properties": {
          "lane_id": {"type": "string"},
          "label": {"type": ["string", "null"]},
          "actor": {"type": ["string", "null"]},
          "role": {"enum": ["human", "orchestrator", "reviewer", "worker", null]},
          "depth": {"type": ["integer", "null"]},
          "parent_lane": {"type": ["string", "null"]},
          "events": {"type": "array", "items": {"type": "string"}},
          "hyo_hierarchy": {"type": ["object", "null"]}
        }
      }
    },
    "event_order": {"type": "array", "items": {"type": "string"}},
    "events": {"type": "object"},
    "edges_causal": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "target"],
        "properties": {
          "source": {"type": ["string", "null"]},
          "target": {"type": ["string", "null"]}
        }
      }
    },
    "edges_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "target", "target_kind", "source_resolved", "source_after_target"],
        "properties": {
          "source": {"type": ["string", "null"]},
          "target": {"type": ["string", "null"]},
          "target_kind": {"type": ["string", "null"]},
          "source_resolved": {"type": "boolean"},
          "source_after_target": {"type": ["boolean", "null"]}
        }
      }
    },
    "decisions_by_run": {"type": "object"},
    "missing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unresolved_refs", "cross_run_refs", "unclassified_events", "unmeasured_events", "calls_without_terminal_outcome", "duplicate_terminal_outcomes", "calls_without_result", "runs_without_intent"],
      "properties": {
        "unresolved_refs": {"type": "array"},
        "cross_run_refs": {"type": "array"},
        "unclassified_events": {"type": "array", "items": {"type": "string"}},
        "unmeasured_events": {"type": "array", "items": {"type": "string"}},
        "calls_without_terminal_outcome": {"type": "array", "items": {"type": "string"}},
        "duplicate_terminal_outcomes": {"type": "array", "items": {"type": "string"}},
        "calls_without_result": {"type": "array", "items": {"type": "string"}},
        "runs_without_intent": {"type": "array", "items": {"type": "string"}}
      }
    },
    "coverage": {"type": "object"},
    "topology": {
      "type": "object",
      "additionalProperties": false,
      "required": ["acyclic", "references_resolved", "structurally_valid", "components", "cycles"],
      "properties": {
        "acyclic": {"type": ["boolean", "null"]},
        "references_resolved": {"type": ["boolean", "null"]},
        "structurally_valid": {"type": ["boolean", "null"]},
        "components": {"type": "array"},
        "cycles": {"type": "array"}
      }
    }
  }
}
