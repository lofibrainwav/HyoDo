---
// Resolved against this source file at build time, so the homepage cannot drift
// from the package it describes. `?raw` is what survives bundling here: the
// frontmatter is compiled into dist/, where a runtime path lookup would resolve
// against the bundle rather than against this file.
import versionFile from '../../../VERSION?raw';

import '../styles/tokens.css';
import '../styles/evidence-graph.css';

const publicVersion = versionFile.trim();
const pypiUrl = 'https://pypi.org/project/hyodo/';
const githubUrl = 'https://github.com/lofibrainwav/HyoDo';
const installCommand = 'pipx install hyodo';
const siteDescription = 'See which project checks ran on AI-assisted work, what they found, and what remains unknown. HyoDo runs locally and leaves decisions to people.';
const canonicalUrl = 'https://hyodo.app/';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>HyoDo — Evidence before "done"</title>
		<meta name="description" content={siteDescription} />
		<link rel="canonical" href={canonicalUrl} />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="HyoDo" />
		<meta property="og:title" content="HyoDo — Evidence before done" />
		<meta property="og:description" content={siteDescription} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:image" content={new URL('/og-image.png', canonicalUrl).href} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="HyoDo — When AI says done, ask what proves it." />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content="HyoDo — Evidence before done" />
		<meta name="twitter:description" content={siteDescription} />
		<meta name="twitter:image" content={new URL('/og-image.png', canonicalUrl).href} />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="icon" href="/favicon.ico" sizes="32x32" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<meta name="theme-color" content="#0b0d10" />
		<style>
			:root {
				--bg: #0a0b0d;
				--bg-raised: #131519;
				--border: #24272e;
				--text: #eef0f3;
				--text-dim: #9aa1ac;
				--accent: #6ee7b7;
				--accent-dim: #1f3d33;
				/*
				 * The navbar is fixed, so it covers whatever sits under the top
				 * of the viewport. Hero reserves exactly this much space instead
				 * of estimating it. This is the desktop height; tokens.css makes
				 * the bar shorter below 560px, so the reservation is a floor and
				 * never leaves the copy underneath the bar.
				 */
				--navbar-height: 3.5rem;
				font-synthesis: none;
			}

			* {
				box-sizing: border-box;
			}

			html,
			body {
				margin: 0;
				padding: 0;
			}

			body {
				background: var(--bg);
				color: var(--text);
				font-family:
					-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial,
					sans-serif;
				line-height: 1.55;
			}

			a {
				color: var(--accent);
			}

			.wrap {
				max-width: 860px;
				margin: 0 auto;
				padding: 0 1.5rem;
			}

			.skip-link {
				position: fixed;
				z-index: 30;
				top: 0.75rem;
				left: 0.75rem;
				transform: translateY(calc(-100% - 1rem));
				padding: 0.65rem 0.85rem;
				border: 1px solid var(--accent);
				border-radius: 0.35rem;
				background: var(--bg-raised);
				color: var(--text);
				text-decoration: none;
			}

			.skip-link:focus {
				transform: translateY(0);
			}

			:focus-visible {
				outline: 2px solid #5aa9ff;
				outline-offset: 4px;
			}

			.eyebrow {
				display: inline-block;
				font-size: 0.8rem;
				letter-spacing: 0.08em;
				text-transform: uppercase;
				color: var(--accent);
				margin-bottom: 1.25rem;
			}

			h1 {
				font-size: clamp(1.8rem, 4.5vw, 2.75rem);
				line-height: 1.2;
				margin: 0 0 1rem;
			}

			.subline {
				font-size: 1.1rem;
				color: var(--text-dim);
				max-width: 44rem;
				margin: 0 0 2rem;
			}

			.install-block {
				display: flex;
				align-items: center;
				gap: 0.75rem;
				flex-wrap: wrap;
				background: var(--bg-raised);
				border: 1px solid var(--border);
				border-radius: 0.5rem;
				padding: 0.9rem 1.1rem;
				max-width: fit-content;
			}

			.install-block code {
				font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
				font-size: 0.95rem;
				color: var(--text);
			}

			.copy-btn {
				background: var(--accent-dim);
				color: var(--accent);
				border: 1px solid var(--accent);
				border-radius: 0.35rem;
				padding: 0.3rem 0.7rem;
				font-size: 0.8rem;
				cursor: pointer;
			}

			.copy-btn:hover {
				background: var(--accent);
				color: #06231a;
			}

			.copy-status {
				position: absolute;
				width: 1px;
				height: 1px;
				padding: 0;
				margin: -1px;
				overflow: hidden;
				clip: rect(0, 0, 0, 0);
				white-space: nowrap;
				border: 0;
			}

			.quickstart-link {
				display: inline-flex;
				min-height: 2.75rem;
				align-items: center;
				margin-top: 0.6rem;
				font-size: 0.9rem;
				text-decoration: none;
			}

			.quickstart-link:hover {
				text-decoration: underline;
				text-underline-offset: 0.25em;
			}

			main {
				padding: 0 0 3rem;
			}

			main > .eg-page.eg-embed {
				margin-top: 3rem;
			}

			section.layer {
				padding: 2.25rem 0;
				border-bottom: 1px solid var(--border);
			}

			section.layer:last-of-type {
				border-bottom: none;
			}

			section.layer h2 {
				font-size: 1.3rem;
				margin: 0 0 0.6rem;
			}

			section.layer p {
				color: var(--text-dim);
				margin: 0 0 0.9rem;
				max-width: 42rem;
			}

			.layer a.docs-link {
				font-size: 0.95rem;
				text-decoration: none;
				border-bottom: 1px solid var(--accent);
			}

			.layer a.docs-link:hover {
				opacity: 0.85;
			}

			footer {
				border-top: 1px solid var(--border);
				padding: 2.5rem 0 3.5rem;
				color: var(--text-dim);
				font-size: 0.9rem;
			}

			footer .links {
				display: flex;
				gap: 1.5rem;
				flex-wrap: wrap;
			}

			footer .boundary {
				margin: 1.25rem 0 0;
				max-width: 60ch;
				line-height: 1.6;
			}

			footer .boundary strong {
				color: var(--text);
				font-weight: 600;
			}

			footer a {
				color: var(--text-dim);
			}

			footer a:hover {
				color: var(--accent);
			}

			.navbar {
				position: fixed;
				top: 0;
				left: 0;
				right: 0;
				z-index: 10;
				display: flex;
				align-items: center;
				justify-content: space-between;
				padding: 1rem 1.5rem;
				background: rgba(10, 11, 13, 0.85);
				backdrop-filter: blur(6px);
				border-bottom: 1px solid var(--border);
				transition: transform 300ms ease-out;
			}

			.navbar.nav-hidden {
				transform: translateY(-100%);
			}

			.navbar .brand {
				font-size: 0.95rem;
				font-weight: 600;
				color: var(--text);
				text-decoration: none;
			}

			.navbar .nav-links {
				display: flex;
				gap: 1.25rem;
				font-size: 0.9rem;
			}

			.navbar .nav-links a {
				color: var(--text-dim);
				text-decoration: none;
			}

			.navbar .nav-links a:hover {
				color: var(--accent);
			}

			/*
			 * Full-viewport hero: min-height is a fixed CSS value (100svh),
			 * known before any content or script runs, so this reserves its
			 * layout box with zero CLS. min-height, not height: the copy stays
			 * in normal flow, so when it needs more room than the viewport has
			 * -- a 320px-wide screen, a short landscape window, enlarged text --
			 * the section grows instead of pushing the heading out of view.
			 * The canvas/poster layer is the only absolutely positioned part.
			 */
			.hero {
				position: relative;
				display: flex;
				flex-direction: column;
				justify-content: flex-end;
				min-height: 100svh;
				padding-top: var(--navbar-height);
				border-bottom: 1px solid var(--border);
			}

			.hero-canvas-wrap {
				position: absolute;
				inset: 0;
				z-index: 0;
				/*
				 * Clipping belongs to the background layer. On .hero it would
				 * cut off copy that legitimately overflows a short viewport.
				 */
				overflow: hidden;
				background: var(--bg);
			}

			.hero-canvas-wrap canvas,
			.hero-canvas-wrap img {
				position: absolute;
				inset: 0;
				width: 100%;
				height: 100%;
				display: block;
				object-fit: cover;
			}

			.hero-canvas-wrap canvas {
				z-index: 1;
			}

			.hero-canvas-wrap img {
				/*
				 * The poster stays on top of the canvas until mount.ts
				 * confirms a frame has rendered, then hides itself. This
				 * also means the canvas keeps a layout box the whole time
				 * (no `hidden`/display:none on it), so IntersectionObserver
				 * can see it and trigger the lazy import.
				 */
				z-index: 2;
			}

			.hero-canvas-wrap img[hidden] {
				/*
				 * Author-origin `display: block` above would otherwise beat
				 * the user-agent stylesheet's `[hidden] { display: none }`,
				 * since normal author rules always win over UA rules in the
				 * cascade regardless of specificity. State it explicitly.
				 */
				display: none;
			}

			.hero-scrim {
				position: absolute;
				inset: 0;
				z-index: 3;
				background: linear-gradient(
					to top,
					rgba(10, 11, 13, 0.92) 0%,
					rgba(10, 11, 13, 0.6) 32%,
					rgba(10, 11, 13, 0) 65%
				);
				pointer-events: none;
			}

			.hero-content {
				/*
				 * In normal flow. `position: absolute` here took the copy out of
				 * flow, so .hero could not grow to fit it and the heading was
				 * pushed above the top of the viewport on small screens.
				 * Relative positioning is still needed for z-index to apply over
				 * the canvas and scrim.
				 */
				position: relative;
				width: 100%;
				padding-bottom: 4rem;
				z-index: 4;
			}

			.hero-word {
				display: inline-block;
			}
		</style>
	</head>
	<body>
		<a class="skip-link" href="#main-content">Skip to content</a>
		<nav class="navbar" data-hero-navbar>
			<a class="brand" href="/">HyoDo</a>
			<div class="nav-links">
				<a href="/docs/quickstart/">Docs</a>
				<a href={githubUrl}>GitHub</a>
				<a href={pypiUrl}>PyPI</a>
			</div>
		</nav>

		<main id="main-content">
		<header class="hero">
			<div class="hero-canvas-wrap" id="hero-canvas-wrap">
				<img
					class="hero-poster"
					data-hero-poster
					src="/hero-poster.svg"
					fetchpriority="high"
					alt=""
					aria-hidden="true"
				/>
				<canvas id="hero-canvas" aria-hidden="true"></canvas>
				<div class="hero-scrim"></div>
			</div>
			<div class="wrap hero-content">
				<span class="eyebrow">Local checks for AI-assisted work</span>
				<h1 id="hero-heading" data-hero-headline>
					When AI says “done,” ask what proves it.
				</h1>
				<p class="subline">
					See which checks ran, what they found, and what remains unknown. HyoDo
					reuses your project's tests and linters. Its guiding Hyo (孝) principle is
					that technology should respect people's time and choices, and carry its
					share of the burden instead of passing it back to them. Missing evidence
					is UNOBSERVED: there is not enough evidence to call it a pass or a failure.
					People decide what to do.
				</p>
				<div class="install-block">
					<code id="install-cmd">{installCommand}</code>
					<button class="copy-btn" id="copy-btn" type="button">Copy</button>
				</div>
				<p class="copy-status" id="copy-status" role="status" aria-live="polite" aria-atomic="true"></p>
				<a class="quickstart-link" href="/docs/quickstart/">New to HyoDo? Read the quickstart →</a>
				<a class="quickstart-link" href="/docs/worked-example/">Or see one finished run first — real output, exit codes, 4.19.9 →</a>
			</div>
		</header>

		<section class="eg-page eg-embed" aria-labelledby="eg-heading">
			<div class="eg-wrap">
				<h2 id="eg-heading">Evidence graph <span class="eg-badge">Prototype</span></h2>
				<p class="eg-key">Rows show participants, columns show steps, and cells show events. A solid line links a causal parent, a dashed line points to supporting evidence, and a red stub marks a broken link.</p>
				<p class="eg-banner" role="note">This interactive example uses sample data only; nothing is uploaded. A local HyoDo dashboard can show the same relationships from a real event ledger.</p>
			<div class="legend" aria-hidden="false">
				<span class="lg-item"
					><span class="lg-dot lg-dot-observed"
					></span><b>ALLOW</b></span
				>
				<span class="lg-item"
					><span class="lg-dot lg-dot-ask"></span><b
						>ASK</b
					></span
				>
				<span class="lg-item"
					><span class="lg-dot lg-dot-deny"></span><b
						>DENY</b
					></span
				>
				<span class="lg-item"
					><span class="lg-dot lg-dot-unobserved"></span><b
						>UNOBSERVED</b
					></span
				>
			</div>

			<p id="eg-instructions" class="sr-only">
				Tab to a cell to inspect its record. Press Escape to clear the panel
				without losing focus. Shift+Tab moves to the previous cell.
			</p>

			<div class="eg-main">
				<div class="graph-wrap" id="eg-root" aria-describedby="eg-instructions">
					<div class="grid" id="eg-grid"></div>
					<svg class="edges" id="eg-edges" aria-hidden="true"></svg>
				</div>
				<aside class="panel" id="eg-panel" aria-live="polite">
					<h2>5W1H</h2>
					<p class="placeholder">
						Hover or focus (Tab) a cell to inspect its record — who, when,
						what, where, how, why.
					</p>
				</aside>
			</div>

				<p><a href="/evidence-graph/">Open the full prototype →</a></p>
			</div>
		</section>

			<div class="wrap">
				<section class="layer" aria-labelledby="claim-lock-heading">
					<h2 id="claim-lock-heading">What HyoDo offers today</h2>
					<p>
						Public version: <strong>HyoDo {publicVersion}</strong>. A shipped adapter is
						not evidence that a host is connected right now. See <a href="/docs/current-state/">how current status is measured</a>.
					</p>
					<table>
						<thead><tr><th>Feature</th><th>Status</th><th>What that means</th></tr></thead>
						<tbody>
							<tr><td>Local project checks</td><td>Available</td><td>Run the checks you configure and keep a local record of what happened.</td></tr>
							<tr><td>Evidence graph</td><td>Available</td><td>Shows how events connect; the example on this page uses sample data.</td></tr>
							<tr><td>Codex and Cursor adapters</td><td>Included</td><td>The adapters are shipped; we have not verified a live connection.</td></tr>
							<tr><td>Information-flow reporting</td><td>Observer only</td><td>Reports data movement; it does not control what an agent can do.</td></tr>
							<tr><td>Hosted ChatGPT connector</td><td>Not live</td><td>Only the connector contract is documented; there is no hosted service.</td></tr>
							<tr><td>Automatic task routing</td><td>Research</td><td>HyoDo does not route tasks to a particular agent or workflow.</td></tr>
							<tr><td>Shared rework reports</td><td>Not built</td><td>HyoDo does not collect or upload reports about rework.</td></tr>
						</tbody>
					</table>
				</section>
			</div>
			<div class="wrap">
				<section class="layer">
					<h2>For people who use AI to build software</h2>
					<p>
						A confident “done” is not proof. HyoDo shows which configured checks
						ran, what they found, and what remains unknown—so you can decide what to trust.
					</p>
					<a class="docs-link" href="/docs/why-hyodo/">Why HyoDo →</a>
				</section>

				<section class="layer">
					<h2>For developers</h2>
					<p>
						Reuse the checks your project already has. HyoDo keeps their commands
						in one gate list and reports what ran; it does not replace the tools themselves.
					</p>
					<a class="docs-link" href="/docs/quickstart/">Quickstart →</a>
				</section>

				<section class="layer">
					<h2>For teams that must show evidence</h2>
					<p>
						See which checks ran, what passed or failed, and what was not measured.
						HyoDo records those results but does not approve a merge or deployment.
					</p>
					<a class="docs-link" href="/docs/trust/">Trust →</a>
				</section>
			</div>
		</main>

		<footer>
			<div class="wrap">
				<div class="links">
					<a href={githubUrl}>GitHub</a>
					<a href={pypiUrl}>PyPI</a>
					<a href="/docs/quickstart/">Docs</a>
					<a href="/docs/research/">Research</a>
					<a href={`${githubUrl}/issues`}>Questions &amp; bug reports</a>
					<a href={`${githubUrl}/blob/main/SECURITY.md`}>Security reporting</a>
					<a href={`${githubUrl}/blob/main/docs/PRODUCT_BOUNDARY.md`}>Maintenance &amp; scope</a>
				</div>
				<p class="boundary">
					<strong>This site has no accounts, no analytics, and no tracking
					cookies.</strong> That was measured, not promised: the live site sets no
					cookie and loads no third-party script, and the page is served under a
					Content-Security-Policy of <code>script-src 'self'</code> and
					<code>connect-src 'self'</code>, so it runs no third-party script and makes
					no cross-origin request from the page. Images and fonts are governed by a
					separate policy and may load over <code>https</code>. None of that tells you
					what the host serving these files records about a request — that is
					unobserved here, not disproved. The evidence graph above runs in your
					browser on bundled sample data.
					<br /><br />
					<strong>The HyoDo tool is a separate surface.</strong> By default it reads
					your checkout, writes under <code>.hyodo/</code> in that same checkout, and
					has no server to report to; installing or running it sends nothing to this
					site or to its maintainers. Two things are yours rather than ours: the gate
					commands you register run whatever you point them at, and an MCP host you
					connect on purpose reads the evidence you hand it. The only way your code or
					results reach us is if you paste them into an issue yourself.
				</p>
			</div>
		</footer>

		<script src="../scripts/landing-page.ts"></script>
	</body>
</html>
