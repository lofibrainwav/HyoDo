{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Offline runbook review examples only. Not a public API or authority verifier. References are not authenticated by schema validation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "evidence_coverage",
    "claim_origin",
    "resolution_state",
    "decision_need",
    "lane_state",
    "public_surface_state",
    "disposition",
    "authority_ref",
    "surface_evidence_ref",
    "exception_ref",
    "evidence_refs"
  ],
  "properties": {
    "evidence_coverage": {
      "enum": [
        "OBSERVED",
        "PARTIAL",
        "UNOBSERVED",
        "CONFLICTING"
      ]
    },
    "claim_origin": {
      "enum": [
        "OBSERVED",
        "DERIVED",
        null
      ]
    },
    "resolution_state": {
      "enum": [
        "RESOLVED",
        "UNRESOLVED"
      ]
    },
    "decision_need": {
      "enum": [
        "NONE",
        "HUMAN_REQUIRED"
      ]
    },
    "lane_state": {
      "enum": [
        "READY",
        "RUNNING",
        "HOLD",
        "BLOCKED",
        "VERIFIED"
      ]
    },
    "public_surface_state": {
      "enum": [
        "LIVE",
        "INTENTIONALLY_UNAVAILABLE",
        "ABSENT",
        null
      ]
    },
    "disposition": {
      "enum": [
        "BLOCKED",
        "WITHIN_AUTHORITY",
        "AUTHORIZED_EXCEPTION"
      ]
    },
    "authority_ref": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "\\S"
        },
        {
          "type": "null"
        }
      ]
    },
    "surface_evidence_ref": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "\\S"
        },
        {
          "type": "null"
        }
      ]
    },
    "exception_ref": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "\\S"
        },
        {
          "type": "null"
        }
      ]
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "\\S"
      },
      "uniqueItems": true
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "decision_need": {
            "const": "HUMAN_REQUIRED"
          }
        },
        "required": [
          "decision_need"
        ]
      },
      "then": {
        "properties": {
          "disposition": {
            "const": "BLOCKED"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "resolution_state": {
            "const": "UNRESOLVED"
          }
        },
        "required": [
          "resolution_state"
        ]
      },
      "then": {
        "properties": {
          "disposition": {
            "enum": [
              "BLOCKED",
              "AUTHORIZED_EXCEPTION"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "lane_state": {
            "enum": [
              "HOLD",
              "BLOCKED"
            ]
          }
        },
        "required": [
          "lane_state"
        ]
      },
      "then": {
        "properties": {
          "disposition": {
            "enum": [
              "BLOCKED",
              "AUTHORIZED_EXCEPTION"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "disposition": {
            "enum": [
              "WITHIN_AUTHORITY",
              "AUTHORIZED_EXCEPTION"
            ]
          }
        },
        "required": [
          "disposition"
        ]
      },
      "then": {
        "properties": {
          "authority_ref": {
            "type": "string",
            "pattern": "\\S"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "disposition": {
            "const": "AUTHORIZED_EXCEPTION"
          }
        },
        "required": [
          "disposition"
        ]
      },
      "then": {
        "properties": {
          "exception_ref": {
            "type": "string",
            "pattern": "\\S"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "public_surface_state": {
            "enum": [
              "LIVE",
              "INTENTIONALLY_UNAVAILABLE",
              "ABSENT"
            ]
          }
        },
        "required": [
          "public_surface_state"
        ]
      },
      "then": {
        "properties": {
          "surface_evidence_ref": {
            "type": "string",
            "pattern": "\\S"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "evidence_coverage": {
            "enum": [
              "OBSERVED",
              "PARTIAL"
            ]
          }
        },
        "required": [
          "evidence_coverage"
        ]
      },
      "then": {
        "properties": {
          "evidence_refs": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "evidence_coverage": {
            "const": "CONFLICTING"
          }
        },
        "required": [
          "evidence_coverage"
        ]
      },
      "then": {
        "properties": {
          "evidence_refs": {
            "minItems": 2
          }
        }
      }
    }
  ]
}
